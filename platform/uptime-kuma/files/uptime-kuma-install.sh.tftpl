#!/bin/bash

set -Eeuo pipefail

umask 077
LOG_FILE="/var/log/uptime-kuma-bootstrap.log"
touch "$LOG_FILE"
chmod 0600 "$LOG_FILE"

# 화면 출력과 오류 출력을 설치 로그 및 cloud-init 로그에 함께 남깁니다.
exec > >(tee -a "$LOG_FILE") 2>&1

log() {
  printf '[%s] %s\n' "$(date -Is)" "$*"
}

STAGE="초기화"
trap 'rc=$?; log "설치 실패: 단계=$STAGE, 종료 코드=$rc"; exit "$rc"' ERR

IMAGE="${uptime_kuma_image}"

# Nitro 인스턴스에서는 EBS가 NVMe로 보이므로 볼륨 ID로 디바이스를 찾습니다.
DATA_VOLUME_ID="${data_volume_id}"
DATA_DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${replace(data_volume_id, "-", "")}"
DATA_MOUNT="/data"
KUMA_DIR="$DATA_MOUNT/uptime-kuma"

log "Uptime Kuma 설치 시작 (이미지: $IMAGE, 데이터 볼륨: $DATA_VOLUME_ID)"

# =======================================================
# 1. 데이터 볼륨 연결 대기
# =======================================================
# Terraform은 인스턴스를 만든 다음 볼륨을 연결하므로 디바이스가 생길 때까지 기다립니다.
STAGE="데이터 볼륨 연결 대기"
log "$STAGE: $DATA_DEVICE"
for _ in $(seq 1 60); do
  test -e "$DATA_DEVICE" && break
  sleep 5
done
test -e "$DATA_DEVICE"

# =======================================================
# 2. 파일시스템 준비 및 마운트
# =======================================================
STAGE="데이터 볼륨 파일시스템 확인"
log "$STAGE"
# 파일시스템이 없을 때(새 볼륨)만 포맷합니다.
if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  log "새 볼륨이므로 XFS로 포맷합니다."
  mkfs.xfs "$DATA_DEVICE"
else
  log "기존 파일시스템을 재사용합니다."
fi

STAGE="데이터 볼륨 마운트"
log "$STAGE: $DATA_MOUNT"
DATA_UUID="$(blkid -s UUID -o value "$DATA_DEVICE")"
test -n "$DATA_UUID"
mkdir -p "$DATA_MOUNT"
if ! grep -q "UUID=$DATA_UUID" /etc/fstab; then
  echo "UUID=$DATA_UUID $DATA_MOUNT xfs defaults,nofail 0 2" >> /etc/fstab
fi
systemctl daemon-reload
mountpoint -q "$DATA_MOUNT" || mount "$DATA_MOUNT"
mountpoint -q "$DATA_MOUNT"
install -d -m 0700 "$KUMA_DIR"

# =======================================================
# 3. Docker 설치
# =======================================================
STAGE="Docker 설치"
log "$STAGE"
dnf install -y docker
systemctl enable --now docker.service

STAGE="이미지 다운로드"
log "$STAGE"
for _ in $(seq 1 3); do
  docker pull "$IMAGE" && break
  sleep 10
done
docker image inspect "$IMAGE" >/dev/null

# =======================================================
# 4. systemd 서비스 등록
# =======================================================
# 대시보드는 로컬 3001 포트에만 열고 SSM 포트포워딩으로 접속합니다.
# 데이터 볼륨이 마운트되지 않은 상태에서는 서비스가 시작되지 않습니다.
STAGE="서비스 등록"
log "$STAGE"
cat > /etc/systemd/system/uptime-kuma.service <<UNIT
[Unit]
Description=Uptime Kuma
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=$DATA_MOUNT

[Service]
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f uptime-kuma
ExecStart=/usr/bin/docker run --rm --name uptime-kuma \
  -p 127.0.0.1:3001:3001 \
  -v $KUMA_DIR:/app/data \
  -e TZ=Asia/Seoul \
  $IMAGE
ExecStop=/usr/bin/docker stop uptime-kuma

[Install]
WantedBy=multi-user.target
UNIT
chmod 0644 /etc/systemd/system/uptime-kuma.service
systemctl daemon-reload
systemctl enable --now uptime-kuma.service

# =======================================================
# 5. 상태 확인
# =======================================================
STAGE="서비스 상태 확인"
log "$STAGE"
for _ in $(seq 1 30); do
  curl --silent --fail --output /dev/null http://127.0.0.1:3001/ && break
  sleep 5
done
curl --silent --fail --output /dev/null http://127.0.0.1:3001/

timedatectl set-timezone Asia/Seoul

log "설치 성공: Uptime Kuma가 실행 중입니다."
