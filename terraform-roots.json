        "platform/network",
        "platform/wazuh"
      ]
    },
    "platform/network": {
      "depends_on": []
    },
    "platform/wazuh": {
      "depends_on": [
        "platform/network"
      ]
    },
    "platform/victim": {
      "depends_on": [
        "platform/network",
        "platform/wazuh"
      ]
    },
    "wazuh-logging/waf-log": {
      "depends_on": [
        "platform/wazuh",
        "platform/victim"
      ]
    },
    "wazuh-logging/guardduty": {
      "depends_on": [
        "platform/wazuh"
      ]
    },
    "platform/attacker": {
      "depends_on": [
        "platform/wazuh"
      ]
    }
  }
}
